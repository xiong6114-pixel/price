# Ignore everything by default, then explicitly keep the active source tree.
*
!/.gitignore
!/README.md
!/case_studies/
!/case_studies/**
!/heron/
!/heron/**

# Python caches
__pycache__/
*.py[cod]

# Local environments and tool state
.venv/
.agents/
.codex/

# Large local artifacts
outputs/
*.xlsx
*.xls
*.pdf
